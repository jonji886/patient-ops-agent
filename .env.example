# Application
APP_ENV=development
LOG_LEVEL=INFO

# Local development profile: SQLite does not require Docker or a DB server.
# SQLite files are created under ./var/patient_ops/ (ignored by Git).
AGENT_DATABASE_URL=sqlite:///./var/patient_ops/agent_ops.db
PATIENT_OPS_DATABASE_URL=sqlite:///./var/patient_ops/patient_ops.db
CLINIC_CORE_DATABASE_URL=sqlite:///./var/patient_ops/clinic_core.db

# PostgreSQL deployment profile. Docker Compose overrides the three URLs below;
# passwords are only required when running docker compose.
POSTGRES_PASSWORD=replace-with-local-admin-password
AGENT_DB_PASSWORD=replace-with-local-agent-password
PATIENT_OPS_DB_PASSWORD=replace-with-local-patient-password
CLINIC_CORE_DB_PASSWORD=replace-with-local-clinic-password

# Mock service endpoints
PATIENT_OPS_BASE_URL=http://localhost:8001
CLINIC_CORE_BASE_URL=http://localhost:8002

# LLM provider; real model mode requires a secret and explicit model
LLM_PROVIDER=fake
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=1

# Stable business clock for the local SQLite + fake-provider synthetic demo.
# DeepSeek and PostgreSQL profiles use the system clock instead.
DEMO_BUSINESS_CLOCK=2026-08-14T09:00:00+08:00

# Workflow and worker
CONFIRMATION_TTL_SECONDS=300
MAX_RETRY_ATTEMPTS=3
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_LEASE_SECONDS=60

# Synthetic actor token signing secret; replace locally, never commit the value
ACTOR_TOKEN_SIGNING_SECRET=change-me-in-development-only

# Interactive one-shot fault scenarios for the local interview demo.
# Keep false outside an explicitly controlled development/demo environment.
ENABLE_DEMO_SCENARIOS=true

# --- Integration reliability ---
GATEWAY_TIMEOUT_SECONDS=10
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30

# --- Fault injection (off by default; set to demonstrate failure scenarios) ---
# Example: simulate 3-second latency on Clinic Core
#   MOCK_CLINIC_CORE_LATENCY_MS=3000
# Example: force every Clinic Core call to fail (deterministic)
#   MOCK_CLINIC_CORE_FAILURE_RATE=1.0
MOCK_CLINIC_CORE_LATENCY_MS=0
MOCK_CLINIC_CORE_FAILURE_RATE=0.0
MOCK_PATIENT_OPS_LATENCY_MS=0
MOCK_PATIENT_OPS_FAILURE_RATE=0.0
